# Article 12: Production Deployment
# Environment configuration for production agent

# Google Cloud Configuration
GCP_PROJECT_ID=your-project-id
GOOGLE_API_KEY=your-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# Cloud Run Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Safety Configuration
SAFETY_ENABLED=true
SAFETY_INJECTION_CHECK=true
SAFETY_SENSITIVE_DATA_CHECK=true
SAFETY_MAX_INPUT_LENGTH=5000

# Evaluation Configuration
EVAL_ENABLED=true
EVAL_MIN_CORRECTNESS=0.85
EVAL_MIN_SAFETY=0.95

# Observability Configuration
TRACING_ENABLED=true
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Deployment Configuration
ENVIRONMENT=production
VERSION=1.0.0
SERVICE_NAME=adk-production-agent
