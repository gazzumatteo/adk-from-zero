# Article 07: MCP Tools Integration
# Environment configuration for MCP integration examples

# Google API Configuration
GOOGLE_API_KEY=your-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# MCP Server Configuration
MCP_ERP_SERVER_COMMAND=python
MCP_ERP_SERVER_ARGS="-m mcp_servers.erp_server"

# Remote MCP Server (for agent_remote.py)
REMOTE_MCP_SERVER_URL=http://localhost:8000
MCP_HTTP_TIMEOUT=30

# Filesystem MCP Configuration
MCP_FILESYSTEM_ALLOWED_DIRS=${HOME}

# Logging
LOG_LEVEL=INFO
