# Article 08: A2A Protocol
# Environment configuration for Agent-to-Agent communication

# Google API Configuration
GOOGLE_API_KEY=your-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# A2A Server Configuration
A2A_HOST=0.0.0.0
A2A_PORT=8001
A2A_DEBUG=false

# Root Agent Configuration
ROOT_AGENT_MODEL=gemini-3-flash-preview

# Remote Agent URLs
LOGISTICS_AGENT_URL=http://localhost:8001

# Logging
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
