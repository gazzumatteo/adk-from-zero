# Article 09: A2UI Generative UI
# Environment configuration for A2UI generation examples

# Google API Configuration
GOOGLE_API_KEY=your-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# Output Configuration
OUTPUT_FORMAT=json
OUTPUT_SCHEMA=UIBlueprint

# UI Theme
UI_THEME=light
UI_REFRESH_INTERVAL=30

# Logging
LOG_LEVEL=INFO
