# Article 11: Dynamic Agent Factory
# Environment configuration for agent factory

# Google API Configuration
GOOGLE_API_KEY=your-api-key-here
GOOGLE_MODEL=gemini-3-flash-preview

# Agent Factory Configuration
FACTORY_MODEL_DEFAULT=gemini-3-flash-preview
FACTORY_MODEL_COMPLEX=gemini-3.1-pro-preview

# Registry Configuration
REGISTRY_PERSISTENCE=true
REGISTRY_STORAGE_PATH=./agents_registry.json

# Logging
LOG_LEVEL=INFO
